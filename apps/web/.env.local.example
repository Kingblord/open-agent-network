# ============================================================
# BAN Smart Money — Environment Variables Reference (EXAMPLE)
# Copy values into your own .env.local (git-ignored). Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# 1. Firebase Web SDK — PUBLIC
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your:app:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Non-public server-side variants
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:your:app:web:your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------
# 2. Firebase Admin SDK — SERVER-SIDE ONLY (never expose)
#    Generate/download the service-account JSON from the Firebase console.
# ------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_MULTILINE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ------------------------------------------------------------
# 3. Auth & App
# ------------------------------------------------------------
# Generate with:  openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# 4. Thirdweb (wallet connection + onchain auth)
#    client id: PUBLIC — from thirdweb dashboard
#    secret key: SERVER-SIDE ONLY — used to verify wallet ownership
#    (getServerThirdwebClient in lib/thirdweb.ts uses this)
# ------------------------------------------------------------
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# ------------------------------------------------------------
# 5. BNB Smart Chain / blockchain execution (server-side)
# ------------------------------------------------------------
# Public BNB mainnet RPC. You can use a provider (Alchemy/QuickNode/Binance
# public RPC) — set to the mainnet dataseed or your own endpoint.
BAN_RPC_URL=https://bsc-dataseed1.binance.org
# BNB Smart Chain mainnet chain id. DO NOT change to a testnet in production.
BAN_CHAIN_ID=56
# Signer private key (dev/test only). NEVER a user's key, NEVER the AI's key.
# This is the key the session-signer uses to submit approved executions.
BAN_BNB_PRIVATE_KEY=your_dev_signer_private_key_hex

# ------------------------------------------------------------
# 5b. Per-agent keystore encryption (REQUIRED for durable agent wallets)
#     Generate with:  openssl rand -hex 32
#     Encrypts per-agent Altana private-key signers in Firestore
#     (agent_keystores collection). Without this, agents keep falling back to
#     the operator key / ephemeral /tmp and lose per-agent wallets on redeploy.
# ------------------------------------------------------------
BAN_KEYSTORE_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ------------------------------------------------------------
# 6. Altana Wallet-Relay (scope-session signer)
#    Used by the SessionSigner boundary to sign only within a session's
#    allowed contracts/functions/tokens/spend caps. Leave unset to disable.
# ------------------------------------------------------------
ALTANA_RELAY_URL=https://your-altana-relay.example.com
ALTANA_TOKEN=your_altana_token

# ------------------------------------------------------------
# 7. AI (OpenRouter) — server-side
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default reasoning model
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Set to "openrouter" to use the REAL OpenRouter brain for the reasoning/
# proposing stage (requires OPENROUTER_API_KEY / optional OPENROUTER_MODEL).
# Unset (or any other value) -> deterministic DevBrainAdapter (hermetic,
# fail-closed, no network). Never fabricates either way.
BAN_AI_PROVIDER=openrouter

# ------------------------------------------------------------
# 8. Inngest (optional; only if using the durable-job control plane)
# ------------------------------------------------------------
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key