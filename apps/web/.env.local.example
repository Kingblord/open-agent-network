# ------------------------------------------------------------
# 5. BNB Smart Chain / blockchain execution (server-side)
# ------------------------------------------------------------
# Public BNB mainnet RPC. You can use a provider (Alchemy/QuickNod/Binance
# public RPC) — set to the mainnet dataseed or your own endpoint.
BAN_RPC_URL=https://bsc-dataseed1.binance.org
# BNB Smart Chain mainnet chain id. DO NOT change to a testnet in production.
BAN_CHAIN_ID=56
# Signer private key (dev/test only). NEVER a user's key, NEVER the AI's key.
# This is the key the session-signer uses to submit approved executions.
BAN_BNB_PRIVATE_KEY=your_dev_signer_private_key_hex

# ------------------------------------------------------------
# 5b. ERC-8004 live scan (8004scan.io) — market place discovery
#     Optional. When set, the market place (/api/agents and
#     /api/erc8004/agents) pull ALIVE external agent listings from
#     https://8004scan.io/api/v1/agents with this key (60s TTL in-memory;
#     honest fail-open: if unset/unreachable, only BAN-native + already-known
#     listings appear, nothing is fabricated). Discovery NEVER grants
#     execution authority — execution still requires a BAN registry agent.
# ------------------------------------------------------------
ERC8004_SCAN_API_KEY=8004_5SYV0HLuTOGDK8EiAFztKmEZWylVIxgh_b7831cf8

# ------------------------------------------------------------
# 5c. EIP-7702 dev testing key (MAINET revocation tests)
#     A PRIVATE KEY FUNDED WITH A LITTLE BNB ON MAINTET that you control.
#     Used ONLY by dev-only/test code paths to submit EIP-7702 activation and
#     revocation transactions directly on mainnet during development
#     (e.g. exercising the revocation flow end-to-end). This is NEVER a user's
#     key and NEVER the AI's key. It is only ever read at the single dev/test
#     call site — no production execution logic references it.
# ------------------------------------------------------------
DEV_PRIVATE_KEY=your_dev_private_key_hex_funded_with_little_bnb