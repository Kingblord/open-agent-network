{
  "name": "@ban/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify:seeds": "tsc -p tsconfig.json && node dist/seed-catalog/verify-seeds.js",
    "fetch:seeds": "tsc -p tsconfig.json && node dist/seed-catalog/fetch-deployments.js"
  },
  "dependencies": {
    "@ban/schemas": "workspace:*",
    "@ban/shared": "workspace:*",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}