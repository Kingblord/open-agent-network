# pnpm build-script allowlist (works for pnpm 10 and 11).
# pnpm 11 no longer honors onlyBuiltDependencies from pnpm-workspace.yaml in the
# frozen/CI install path, which caused ERR_PNPM_IGNORED_BUILDS on Vercel.
only-built-dependencies[]=@firebase/util
only-built-dependencies[]=bufferutil
only-built-dependencies[]=esbuild
only-built-dependencies[]=keccak
only-built-dependencies[]=msw
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
only-built-dependencies[]=utf-8-validate